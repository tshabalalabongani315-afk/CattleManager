# Copy to backend/.env for local development. Never commit the real .env.

# REQUIRED in production: a long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Postgres connection string (e.g. a Neon database). Leave empty locally to use
# the built-in PGlite database stored in backend/.data/.
DATABASE_URL=

# REQUIRED in production: protects the nightly cleanup endpoint (Vercel Cron
# sends it automatically as a bearer token). Any long random string.
CRON_SECRET=

# Only needed if the frontend is served from a different origin than the API
# (comma-separated). Not needed with the Vite dev proxy or on Vercel.
ALLOWED_ORIGINS=
